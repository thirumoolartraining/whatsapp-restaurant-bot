# Environment (MUST be "production" in production)
NODE_ENV=development

# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/restaurant_bot

# JWT Secret (use a strong, random string in production)
JWT_SECRET=your_jwt_secret_key_here_change_this_in_production

# Server
PORT=5000
BACKEND_URL=https://your-domain.onrender.com
WEBSITE_URL=https://your-domain.vercel.app

# Admin Credentials (change these in production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password

# WhatsApp Business API (Meta Cloud)
META_ACCESS_TOKEN=__REPLACE_WITH_META_ACCESS_TOKEN__
META_BUSINESS_ID=__REPLACE_WITH_BUSINESS_ID__
META_PHONE_NUMBER_ID=__REPLACE_WITH_PHONE_NUMBER_ID__
META_APP_SECRET=__REPLACE_WITH_APP_SECRET__
META_VERIFY_TOKEN=__REPLACE_WITH_VERIFY_TOKEN__
WHATSAPP_OFFER_TEMPLATE=hello_world

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_CONFIG_ID=your_razorpay_config_id

# Cloudinary (Image Upload)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google Sheets API
GOOGLE_SHEET_ID=your_google_sheet_id
GOOGLE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"your-project","private_key":"your-private-key","client_email":"your-service-account@your-project.iam.gserviceaccount.com"}'

# Groq AI (Chatbot Intelligence)
GROQ_API_KEY=your_groq_api_key

# Sendinblue/Brevo (Email Service)
BREVO_API_KEY=your_brevo_api_key
BREVO_FROM_EMAIL=your_email@example.com
BREVO_FROM_NAME="Your Restaurant Name"

# Business Information
MERCHANT_NAME=Your Restaurant Name
MERCHANT_UPI_VPA=your_upi_vpa@ybl
REPORT_EMAIL=your_report_email@example.com
GOOGLE_REVIEW_URL=https://your-google-review-url
